# RailSentinel SIH26028 - Environment Configuration
# ------------------------------------------------------
# These are placeholders - do not use real keys in version control.

# OpenWeatherMap API key (optional, for weather flag feature)
OPENWEATHER_API_KEY=

# Person 2 (Position/Risk service) base URL
PERSON2_BASE_URL=http://127.0.0.1:8001

# Risk polling interval in seconds
RISK_POLL_INTERVAL_SECONDS=10

# Server port
PORT=8000

# Base data directory (project-relative)
DATA_DIR=data

# Model directory for trained artifacts
MODEL_DIR=models

# Scraping configuration
SCRAPING_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30
