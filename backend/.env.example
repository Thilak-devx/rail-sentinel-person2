APP_NAME=RailSentinel Position Service
DEBUG=true
CORS_ORIGINS=["*"]
POSITION_HISTORY_SIZE=50
MAP_MATCHING_MAX_DISTANCE=100.0
WEATHER_PROVIDER=openweathermap
FLOOD_PROVIDER=mock
RISK_REFRESH_INTERVAL_SECONDS=600
OPENWEATHER_API_KEY=your_openweather_api_key_here
CWC_API_KEY=
